<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Composer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Composer-footer')]" position="inside">
<div class="o-mail-Composer-footer overflow-auto o-scrollbar-thin">
    <t t-if="currentAgentInfo">
        <div class="ai-cyber-panel d-flex align-items-center gap-2 p-1 mb-2 rounded-3">

            <div class="ai-cyber-select-group d-flex align-items-center rounded-2 px-2 py-1">
                <i class="fa fa-robot ai-neon-glow-green me-2"/>
                <span class="fw-bold text-gradient-green" style="font-size: 11px;" t-esc="currentAgentInfo.name"/>
            </div>

            <div class="ai-cyber-divider"></div>

            <div class="ai-cyber-select-group d-flex align-items-center rounded-2 px-2 py-1">
                <i class="fa fa-brain ai-neon-glow-purple me-2"/>
                <span class="font-monospace fw-bold text-gradient-blue" style="font-size: 11px;" t-esc="currentAgentInfo.llm_model"/>
            </div>

            <t t-if="sessionUsageLabel">
                <div class="ai-cyber-divider"></div>
                <div class="ai-cyber-select-group d-flex align-items-center rounded-2 px-2 py-1"
                     title="Tokens used in this conversation (this session)">
                    <i class="fa fa-bolt ai-neon-glow-green me-2"/>
                    <span class="font-monospace fw-bold text-gradient-green" style="font-size: 11px;"
                          t-esc="sessionUsageLabel"/>
                </div>
            </t>

            <t t-if="isAiGenerating">
                <div class="ai-cyber-divider"></div>
                <button class="btn btn-sm btn-outline-danger d-flex align-items-center rounded-2 px-2 py-1 ai-stop-btn"
                        style="font-size: 11px;"
                        title="Stop generating"
                        t-on-click="stopAiGeneration">
                    <i class="fa fa-stop me-1"/>Stop
                </button>
            </t>

        </div>
    </t>

    </div>
        </xpath>
    </t>
</templates>
