<?xml version="1.0"?>
<odoo>
    <data>
        <record id="ir_cron_generate_ai_embedding" model="ir.cron">
            <field name="name">AI Embedding: Generate AI Embeddings</field>
            <field name="model_id" ref="ai_chatbot_enhance.model_ai_en_embedding"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_embedding()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">9999</field>
            <field name="interval_type">months</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_ai_digest" model="ir.cron">
            <field name="name">AI Digest: Run Scheduled Reports</field>
            <field name="model_id" ref="ai_chatbot_enhance.model_ai_digest"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_digests()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_ai_audit_gc" model="ir.cron">
            <field name="name">AI Audit: Clean Old Logs</field>
            <field name="model_id" ref="ai_chatbot_enhance.model_ai_audit_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
    <data>
        <record id="ir_cron_ai_process_sources" model="ir.cron">
            <field name="name">AI Agent Sources: Process AI Sources</field>
            <field name="model_id" ref="ai_chatbot_enhance.model_ai_en_agent_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_sources()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">9999</field>
            <field name="interval_type">months</field>
        </record>
    </data>
</odoo>
