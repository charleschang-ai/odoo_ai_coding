<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Token Usage ═══ -->
    <record id="ai_token_usage_view_list" model="ir.ui.view">
        <field name="name">ai.token.usage.list</field>
        <field name="model">ai.token.usage</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="id desc"
                  decoration-muted="is_estimated">
                <field name="create_date" string="Time"/>
                <field name="user_id"/>
                <field name="agent_id" optional="show"/>
                <field name="llm_model"/>
                <field name="provider" optional="hide"/>
                <field name="api_calls" optional="hide" sum="Total"/>
                <field name="tool_calls" optional="hide" sum="Total"/>
                <field name="input_tokens" sum="Total"/>
                <field name="cached_tokens" optional="show" sum="Total"/>
                <field name="output_tokens" sum="Total"/>
                <field name="total_tokens" optional="show" sum="Total"/>
                <field name="is_estimated" optional="hide"/>
                <field name="duration" optional="show"/>
                <field name="cost" sum="Total" widget="float" digits="[12, 4]"/>
            </list>
        </field>
    </record>

    <record id="ai_token_usage_view_graph" model="ir.ui.view">
        <field name="name">ai.token.usage.graph</field>
        <field name="model">ai.token.usage</field>
        <field name="arch" type="xml">
            <graph string="AI Cost" type="bar" sample="1">
                <field name="create_date" interval="day"/>
                <field name="cost" type="measure"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="ai_token_usage_view_pivot" model="ir.ui.view">
        <field name="name">ai.token.usage.pivot</field>
        <field name="model">ai.token.usage</field>
        <field name="arch" type="xml">
            <pivot string="AI Usage Analysis" sample="1">
                <field name="user_id" type="row"/>
                <field name="llm_model" type="col"/>
                <field name="cost" type="measure"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ai_token_usage_view_search" model="ir.ui.view">
        <field name="name">ai.token.usage.search</field>
        <field name="model">ai.token.usage</field>
        <field name="arch" type="xml">
            <search string="Token Usage">
                <field name="user_id"/>
                <field name="agent_id"/>
                <field name="llm_model"/>
                <field name="provider"/>
                <filter string="Estimated" name="estimated" domain="[('is_estimated', '=', True)]"/>
                <group>
                    <filter string="User" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Agent" name="group_agent" domain="[]" context="{'group_by': 'agent_id'}"/>
                    <filter string="Model" name="group_model" domain="[]" context="{'group_by': 'llm_model'}"/>
                    <filter string="Provider" name="group_provider" domain="[]" context="{'group_by': 'provider'}"/>
                    <filter string="Conversation" name="group_channel" domain="[]" context="{'group_by': 'channel_id'}"/>
                    <filter string="Day" name="group_day" domain="[]" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Month" name="group_month" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_token_usage_action" model="ir.actions.act_window">
        <field name="name">Token Usage</field>
        <field name="res_model">ai.token.usage</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="ai_token_usage_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI usage recorded yet</p>
            <p>Every AI response logs its token usage and estimated cost here.
               Configure prices under Model Prices to get cost figures.</p>
        </field>
    </record>

    <!-- ═══ Model Prices ═══ -->
    <record id="ai_llm_price_view_list" model="ir.ui.view">
        <field name="name">ai.llm.price.list</field>
        <field name="model">ai.llm.price</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="llm_model"/>
                <field name="input_price_per_m"/>
                <field name="cached_price_per_m"/>
                <field name="output_price_per_m"/>
            </list>
        </field>
    </record>

    <record id="ai_llm_price_action" model="ir.actions.act_window">
        <field name="name">Model Token Prices</field>
        <field name="res_model">ai.llm.price</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure model prices</p>
            <p>USD per 1 million tokens. Used to estimate the cost of every AI call —
               keep these in sync with your provider contracts.</p>
        </field>
    </record>

    <!-- ═══ AI Digests (scheduled reports) ═══ -->
    <record id="ai_digest_view_list" model="ir.ui.view">
        <field name="name">ai.digest.list</field>
        <field name="model">ai.digest</field>
        <field name="arch" type="xml">
            <list decoration-danger="last_error">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="interval_type"/>
                <field name="next_run"/>
                <field name="last_run" optional="show"/>
                <field name="last_error" optional="show"/>
                <field name="channel_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ai_digest_view_form" model="ir.ui.view">
        <field name="name">ai.digest.form</field>
        <field name="model">ai.digest</field>
        <field name="arch" type="xml">
            <form string="AI Digest">
                <header>
                    <button name="action_run_now" type="object" string="Run Now" class="btn-primary"
                            confirm="Run this digest immediately and deliver the report?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 每周销售摘要"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="interval_type"/>
                            <field name="next_run"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="channel_id"/>
                            <field name="recipient_ids" widget="many2many_tags"/>
                            <field name="last_run"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="prompt" nolabel="1"
                               placeholder="e.g. 总结上周的销售情况：订单数量、总金额、TOP5客户和产品，对比前一周的变化，最后给出本周的两条行动建议。只做查询分析，不要修改任何数据。"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_digest_action" model="ir.actions.act_window">
        <field name="name">AI Digests</field>
        <field name="res_model">ai.digest</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first AI report</p>
            <p>An agent runs your prompt on a schedule and posts the answer to a
               Discuss channel and/or emails it — e.g. a Monday-morning sales recap.</p>
        </field>
    </record>

</odoo>
