<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="ai_menu_root" name="AI Chat" web_icon="ai_chatbot_enhance,static/description/icon.png" sequence="50">

        <!-- ═══ Agents: who talks to users ═══ -->
        <menuitem id="menu_ai_agents_section" name="Agents" sequence="10"
                  groups="ai_chatbot_enhance.group_ai_manager">
            <menuitem id="ai_agent_menu_action" name="Agents" action="ai_agent_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="10"/>
            <menuitem id="menu_ai_composer" name="User Prompts" action="ai_composer_action_custom"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="20"/>
        </menuitem>

        <!-- ═══ Skills & Tools: what agents can do ═══
             AI Skills = ai.en.topic (skill packs: domain knowledge + tool bundle)
             AI Tools  = ir.actions.server (executable function-call tools) -->
        <menuitem id="menu_ai_skills_section" name="Skills &amp; Tools" sequence="20"
                  groups="ai_chatbot_enhance.group_ai_manager">
            <menuitem id="menu_ai_topic" name="AI Skills" action="ai_tools_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="10"/>
            <menuitem id="menu_ai_actions" name="AI Tools" action="ai_actions_server_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="20"/>
        </menuitem>

        <!-- ═══ Reporting: what happened and what it cost ═══ -->
        <menuitem id="menu_ai_reporting_section" name="Reporting" sequence="30"
                  groups="ai_chatbot_enhance.group_ai_manager">
            <menuitem id="menu_ai_token_usage" name="Token Usage" action="ai_token_usage_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="10"/>
            <menuitem id="menu_ai_audit_log" name="Audit Logs" action="ai_audit_log_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="20"/>
            <menuitem id="menu_ai_digest" name="AI Digests" action="ai_digest_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="30"/>
        </menuitem>

        <!-- ═══ AI Studio: system customization (Settings admins only) ═══ -->
        <menuitem id="menu_ai_studio" name="AI Studio" groups="base.group_system" sequence="40">
            <menuitem id="menu_ai_studio_fields"
                      name="Custom Fields"
                      action="action_ai_studio_custom_fields"
                      sequence="10"/>
            <menuitem id="menu_ai_studio_views"
                      name="Custom Views"
                      action="action_ai_studio_custom_views"
                      sequence="20"/>
            <menuitem id="menu_ai_studio_menus"
                      name="Custom Menus"
                      action="action_ai_studio_custom_menus"
                      sequence="30"/>
        </menuitem>

        <!-- ═══ Configuration ═══ -->
        <menuitem id="menu_ai_config_section" name="Configuration" sequence="90"
                  groups="ai_chatbot_enhance.group_ai_manager">
            <menuitem id="menu_ai_llm_price" name="Model Prices" action="ai_llm_price_action"
                      groups="ai_chatbot_enhance.group_ai_manager" sequence="10"/>
            <menuitem id="menu_ai_provider" name="AI Providers" action="action_ai_provider"
                      groups="base.group_system" sequence="20"/>
            <menuitem id="ai_general_settings_menu" name="Settings" action="ai_settings_action_custom"
                      groups="base.group_system" sequence="30"/>
        </menuitem>

    </menuitem>
</odoo>
