<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_audit_log_view_list" model="ir.ui.view">
        <field name="name">ai.audit.log.list</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <list string="AI Audit Logs" create="false" edit="false" delete="false" default_order="id desc"
                  decoration-danger="has_error" decoration-muted="operation_type == 'read'">
                <field name="create_date" string="Time"/>
                <field name="user_id"/>
                <field name="operation_type"/>
                <field name="summary"/>
                <field name="model_name" string="Target" optional="show"/>
                <field name="agent_id" optional="hide"/>
                <field name="tool_name" optional="hide"/>
                <field name="arguments" optional="hide"/>
                <field name="has_error" string="Failed"/>
                <field name="undone" optional="hide"/>
                <field name="duration" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ai_audit_log_view_form" model="ir.ui.view">
        <field name="name">ai.audit.log.form</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <form string="AI Audit Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Time"/>
                            <field name="user_id"/>
                            <field name="agent_id"/>
                            <field name="channel_id"/>
                            <field name="operation_type"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="tool_name"/>
                            <field name="action_id"/>
                            <field name="model_name"/>
                            <field name="target_model"/>
                            <field name="target_record_id"/>
                            <field name="duration"/>
                            <field name="has_error"/>
                            <field name="undone"/>
                        </group>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" nolabel="1"/>
                    </group>
                    <group string="Result">
                        <field name="result" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="not has_error">
                        <field name="error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_audit_log_view_graph" model="ir.ui.view">
        <field name="name">ai.audit.log.graph</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <graph string="AI Usage" type="bar" sample="1">
                <field name="user_id"/>
                <field name="tool_name"/>
            </graph>
        </field>
    </record>

    <record id="ai_audit_log_view_pivot" model="ir.ui.view">
        <field name="name">ai.audit.log.pivot</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <pivot string="AI Usage Analysis" sample="1">
                <field name="user_id" type="row"/>
                <field name="operation_type" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Odoo 19 note: search-view <group> accepts NO expand/string attributes
         (RNG tightened vs older versions) — that's what broke the previous
         version of this view. Follow the core pattern: bare <group> +
         domain="[]" on group_by filters. -->
    <record id="ai_audit_log_view_search" model="ir.ui.view">
        <field name="name">ai.audit.log.search</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <search string="AI Audit Logs">
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <field name="agent_id"/>
                <field name="summary"/>
                <field name="arguments"/>
                <filter string="Failed" name="failed" domain="[('has_error', '=', True)]"/>
                <filter string="Undone" name="undone" domain="[('undone', '=', True)]"/>
                <group>
                    <filter string="User" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Operation" name="group_operation" domain="[]" context="{'group_by': 'operation_type'}"/>
                    <filter string="Tool" name="group_tool" domain="[]" context="{'group_by': 'tool_name'}"/>
                    <filter string="Agent" name="group_agent" domain="[]" context="{'group_by': 'agent_id'}"/>
                    <filter string="Target Model" name="group_model" domain="[]" context="{'group_by': 'model_name'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_audit_log_action" model="ir.actions.act_window">
        <field name="name">AI Audit Logs</field>
        <field name="res_model">ai.audit.log</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="ai_audit_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI operations recorded yet</p>
            <p>Every AI tool execution (search, create, update, archive, ...) is logged here
               with the user, the arguments and the result — for compliance and troubleshooting.</p>
        </field>
    </record>

</odoo>
