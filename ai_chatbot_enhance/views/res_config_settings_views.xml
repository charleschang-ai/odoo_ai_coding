<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app data-string="AI Chatbot" string="AI Chatbot" name="ai_chatbot_enhance">
                    <block title="AI Providers" name="ai_providers">
                        <setting id="openai_provider" string="OpenAI (ChatGPT)" help="Provide your API key to connect with OpenAI" groups="base.group_system">
                            <field name="openai_key_enabled" />
                            <group invisible="not openai_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="openai_key" placeholder="sk-..." password="True" nolabel="1" class="w-100"/>
                                </div>
                            </group>
                        </setting>

                        <setting id="google_provider" string="Google Gemini" help="Provide your API key to connect with Google AI" groups="base.group_system">
                            <field name="google_key_enabled" />
                            <group invisible="not google_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="google_key" placeholder="AIza..." password="True" nolabel="1" class="w-100"/>
                                </div>
                            </group>
                        </setting>

                        <setting id="deepseek_provider" string="DeepSeek" help="Provide your API key to connect with DeepSeek" groups="base.group_system">
                            <field name="deepseek_key_enabled" />
                            <group invisible="not deepseek_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="deepseek_key" placeholder="sk-..." password="True" nolabel="1" class="w-100"/>
                                </div>
                            </group>
                        </setting>

                        <setting id="qwen_provider" string="Qwen"
                                 help="Provide your API key to connect with Qwen" groups="base.group_system">
                            <field name="qwen_key_enabled"/>
                            <group invisible="not qwen_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="qwen_key" placeholder="sk-..." password="True" nolabel="1"
                                           class="w-100"/>
                                </div>
                            </group>
                        </setting>

                        <setting id="kimi_provider" string="Kimi (Moonshot)"
                                 help="Provide your API key to connect with Kimi. Both a Moonshot open platform key (platform.moonshot.cn, sk-...) and a new Kimi platform key (platform.kimi.com, sk-kimi-...) work: the endpoint is chosen from the key automatically." groups="base.group_system">
                            <field name="kimi_key_enabled"/>
                            <group invisible="not kimi_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="kimi_key" placeholder="sk-... (platform.moonshot.cn) or sk-kimi-... (platform.kimi.com)" password="True" nolabel="1"
                                           class="w-100"/>
                                </div>
                            </group>
                        </setting>

                        <setting id="zhipu_provider" string="Zhipu GLM"
                                 help="Provide your API key to connect with Zhipu AI (BigModel)" groups="base.group_system">
                            <field name="zhipu_key_enabled"/>
                            <group invisible="not zhipu_key_enabled">
                                <div class="flex-grow-1">
                                    <field name="zhipu_key" placeholder="..." password="True" nolabel="1"
                                           class="w-100"/>
                                </div>
                            </group>
                        </setting>
                    </block>

                    <block title="AI Behavior" name="ai_behavior">
                        <setting id="ai_chat_retention" string="Chat History Retention"
                                 help="How long AI conversations are kept after the last activity. 0 = keep forever. Empty abandoned chats are always cleaned after one day."
                                 groups="base.group_system">
                            <field name="ai_chat_retention_days" class="o_light_label" style="max-width: 100px;"/> days
                        </setting>
                        <setting id="ai_token_budget" string="Token Budget"
                                 help="Monthly usage limits. AI managers are emailed at 80% and 100% of the company budget; 'Warn and block' also pauses AI when limits are reached."
                                 groups="base.group_system">
                            <div class="mt-2">
                                <label for="ai_budget_monthly_tokens" class="o_light_label me-2"/>
                                <field name="ai_budget_monthly_tokens" style="max-width: 140px;"/>
                            </div>
                            <div class="mt-2">
                                <label for="ai_budget_user_monthly_tokens" class="o_light_label me-2"/>
                                <field name="ai_budget_user_monthly_tokens" style="max-width: 140px;"/>
                            </div>
                            <div class="mt-2">
                                <label for="ai_budget_action" class="o_light_label me-2"/>
                                <field name="ai_budget_action" style="max-width: 200px;"/>
                            </div>
                            <div class="mt-2 text-muted">
                                Used this month:
                                <field name="ai_current_month_tokens" readonly="1" class="oe_inline"/> tokens
                                (~$<field name="ai_current_month_cost" readonly="1" class="oe_inline"/>)
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>

        </field>
    </record>

    <record id="ai_settings_action_custom" model="ir.actions.act_window">
        <field name="name">AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'ai_chatbot_enhance'}</field>
    </record>
</odoo>