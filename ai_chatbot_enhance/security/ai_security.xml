<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ai_chatbot" model="ir.module.category">
        <field name="name">AI Chatbot</field>
        <field name="description">Access rights for the AI Chatbot module</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 19: the users-form dropdown is driven by res.groups.privilege -->
    <record id="res_groups_privilege_ai_chatbot" model="res.groups.privilege">
        <field name="name">AI Chatbot</field>
        <field name="category_id" ref="module_category_ai_chatbot"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_chatbot"/>
        <field name="comment">Can chat with AI agents (systray button, default assistant). Which agent a user may talk to is further restricted per agent via its Allowed Groups.</field>
    </record>

    <record id="group_ai_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        <field name="comment">Can manage AI agents, skills, tools and audit logs, and use the operations/builder assistants. Does NOT require full Settings access.</field>
    </record>

    <!-- Defaults that keep current behaviour: every internal user can use AI;
         every Settings admin is an AI administrator -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ai_manager'))]"/>
    </record>

</odoo>
