<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Trigger-style cron (same pattern as ai_chatbot_enhance): the
             9999-month interval means it effectively only runs when
             _trigger()ed (after each module upgrade). Set interval to 1 day
             if you also want a nightly refresh. -->
        <record id="ir_cron_code_graph_rebuild" model="ir.cron">
            <field name="name">AI Code Graph: Rebuild Index</field>
            <field name="model_id" ref="model_ai_code_graph_builder"/>
            <field name="state">code</field>
            <field name="code">model._cron_rebuild()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">9999</field>
            <field name="interval_type">months</field>
        </record>
    </data>
</odoo>
