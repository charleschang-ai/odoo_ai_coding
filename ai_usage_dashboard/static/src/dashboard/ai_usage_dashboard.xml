<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ai_usage_dashboard.AiUsageDashboard">
    <div class="o_ai_usage_dashboard" t-att-class="{ 'o_ai_usage_dashboard--loading': state.loading }">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <div class="o_ai_usage_header d-flex align-items-center justify-content-between mb-3">
            <h3 class="o_ai_usage_title mb-0">AI Usage Dashboard</h3>
            <div class="o_ai_usage_controls d-flex align-items-center gap-2">
                <!-- Days selector -->
                <div class="btn-group btn-group-sm" role="group">
                    <button class="btn"
                            t-att-class="{ 'btn-primary': state.days === 7, 'btn-outline-primary': state.days !== 7 }"
                            t-on-click="() => this.setDays(7)">7 days</button>
                    <button class="btn"
                            t-att-class="{ 'btn-primary': state.days === 30, 'btn-outline-primary': state.days !== 30 }"
                            t-on-click="() => this.setDays(30)">30 days</button>
                    <button class="btn"
                            t-att-class="{ 'btn-primary': state.days === 90, 'btn-outline-primary': state.days !== 90 }"
                            t-on-click="() => this.setDays(90)">90 days</button>
                </div>
                <!-- Refresh button -->
                <button class="btn btn-sm btn-outline-secondary" t-on-click="refresh" title="Refresh data">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </div>

        <!-- ── Loading overlay ─────────────────────────────────────── -->
        <div t-if="state.loading" class="o_ai_usage_loading_overlay">
            <div class="d-flex align-items-center justify-content-center h-100">
                <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            </div>
        </div>

        <!-- ── KPI Cards ──────────────────────────────────────────── -->
        <div class="o_ai_usage_kpis row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="o_ai_usage_kpi_card card">
                    <div class="card-body text-center">
                        <div class="o_ai_usage_kpi_label text-muted small">Total Cost</div>
                        <div class="o_ai_usage_kpi_value fw-bold fs-4" t-esc="formatCost(state.kpis.total_cost)"/>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="o_ai_usage_kpi_card card">
                    <div class="card-body text-center">
                        <div class="o_ai_usage_kpi_label text-muted small">Total Tokens</div>
                        <div class="o_ai_usage_kpi_value fw-bold fs-4" t-esc="formatTokens(state.kpis.total_tokens)"/>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="o_ai_usage_kpi_card card">
                    <div class="card-body text-center">
                        <div class="o_ai_usage_kpi_label text-muted small">API Calls</div>
                        <div class="o_ai_usage_kpi_value fw-bold fs-4" t-esc="state.kpis.api_calls or 0"/>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="o_ai_usage_kpi_card card">
                    <div class="card-body text-center">
                        <div class="o_ai_usage_kpi_label text-muted small">Avg Cost / Call</div>
                        <div class="o_ai_usage_kpi_value fw-bold fs-4" t-esc="formatCost(state.kpis.avg_cost_per_call)"/>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── By Model & By Agent (two columns) ──────────────────── -->
        <div class="row g-3 mb-4">
            <!-- By Model horizontal bar chart -->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Cost by Model</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="state.byModel.length">
                            <div class="o_ai_usage_bar_list">
                                <div t-foreach="state.byModel" t-as="item" t-key="item.llm_model"
                                     class="o_ai_usage_bar_row d-flex align-items-center mb-2">
                                    <div class="o_ai_usage_bar_label text-truncate" style="width: 140px;"
                                         t-esc="item.llm_model"/>
                                    <div class="o_ai_usage_bar_track flex-grow-1 mx-2 position-relative"
                                         style="height: 22px; background: var(--o-gray-200); border-radius: 4px;">
                                        <div class="o_ai_usage_bar_fill position-absolute top-0 start-0 h-100"
                                             t-att-style="'width:' + barWidthPercent(item.cost) + '%'"
                                             style="background: var(--o-brand-primary); border-radius: 4px;"/>
                                    </div>
                                    <div class="o_ai_usage_bar_value text-end fw-bold"
                                         style="width: 100px; font-size: 0.85rem;"
                                         t-esc="formatCost(item.cost)"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="text-muted text-center mb-0">No data available</p>
                        </t>
                    </div>
                </div>
            </div>

            <!-- By Agent list -->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Cost by Agent</h5>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="state.byAgent.length">
                            <table class="table table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Agent</th>
                                        <th class="text-end">Tokens</th>
                                        <th class="text-end">Calls</th>
                                        <th class="text-end">Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.byAgent" t-as="item" t-key="item.agent_name">
                                        <td t-esc="item.agent_name"/>
                                        <td class="text-end" t-esc="formatTokens(item.total_tokens)"/>
                                        <td class="text-end" t-esc="item.api_calls or 0"/>
                                        <td class="text-end fw-bold" t-esc="formatCost(item.cost)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="card-body">
                                <p class="text-muted text-center mb-0">No data available</p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Recent Usage Table ──────────────────────────────────── -->
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">Recent Usage</h5>
                <!-- Provider filter buttons -->
                <div class="btn-group btn-group-sm" role="group">
                    <button class="btn"
                            t-att-class="{ 'btn-secondary': state.providerFilter === 'all', 'btn-outline-secondary': state.providerFilter !== 'all' }"
                            t-on-click="() => this.setProviderFilter('all')">All</button>
                    <t t-foreach="providers" t-as="provider" t-key="provider">
                        <button class="btn"
                                t-att-class="{ 'btn-secondary': state.providerFilter === provider, 'btn-outline-secondary': state.providerFilter !== provider }"
                                t-on-click="() => this.setProviderFilter(provider)"
                                t-esc="provider"/>
                    </t>
                </div>
            </div>
            <div class="card-body p-0">
                <t t-if="filteredRecent.length">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Agent</th>
                                    <th>Model</th>
                                    <th>Provider</th>
                                    <th class="text-end">Tokens</th>
                                    <th class="text-end">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="filteredRecent" t-as="rec" t-key="rec.id">
                                    <td t-esc="formatDate(rec.create_date)" style="white-space: nowrap;"/>
                                    <td t-esc="rec.agent_name or '(none)'"/>
                                    <td t-esc="rec.llm_model"/>
                                    <td>
                                        <span class="badge" t-att-class="'badge bg-info'"
                                              t-esc="rec.provider"/>
                                    </td>
                                    <td class="text-end" t-esc="formatTokens(rec.total_tokens)"/>
                                    <td class="text-end fw-bold" t-esc="formatCost(rec.cost)"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
                <t t-else="">
                    <div class="card-body">
                        <p class="text-muted text-center mb-0">No records found</p>
                    </div>
                </t>
            </div>
        </div>

    </div>
</t>

</templates>
